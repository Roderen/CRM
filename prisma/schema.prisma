generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id          String    @id @default(cuid())
  userId      String    // ID пользователя из Clerk
  name        String
  email       String?
  phone       String?
  company     String?
  dealAmount  Float?    // сумма сделки
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Project {
  id          String           @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus    @default(PLANNED)
  deadline    DateTime?
  budget      Float?
  notes       String?
  client      Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  tasks       Task[]
  attachments FileAttachment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model FileAttachment {
  id        String   @id @default(cuid())
  name      String
  path      String
  size      Int
  mimeType  String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  createdAt DateTime @default(now())
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  position    Int        @default(0)
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}
